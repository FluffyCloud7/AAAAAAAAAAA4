  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bfc6122d5880cd54ba6904cba18bf544, type: 3}
  m_Name: EightDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: "\u0410\u0432\u0438\u0441"
  npcPortrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  typingSpeed: 0.01
  voiceSoundGroupName: PencilScribe
  voicePitch: 1
  loopVoiceSound: 1
  dialogueLines:
  - text: "\u041F\u043E\u0433\u043E\u0434\u0438-\u043A\u0430... \u0412\u0438\u0434\u0438\u0448\u044C
      \u044D\u0442\u043E\u0442 \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u044B\u0439
      \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u043A \u043D\u0430 \u0437\u0435\u043C\u043B\u0435?"
    portrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  - text: "\u041D\u0435\u0442? \u041D\u0435 \u0432\u0438\u0434\u0438\u0448\u044C?
      \u041D\u0443, \u0435\u0441\u043B\u0438 \u0442\u044B \u043F\u0440\u0438\u0437\u043E\u0432\u0435\u0448\u044C
      \u043C\u0435\u043D\u044F, \u044F \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0443
      \u043A\u0443\u0440\u0441\u043E\u0440 \u043F\u0440\u0438 \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0438
      \u0437\u0435\u043B\u0435\u043D\u044B\u043C, \u0447\u0442\u043E\u0431\u044B
      \u0442\u044B \u0442\u043E\u0447\u043D\u043E \u0435\u0433\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u043B."
    portrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  - text: "\u042D\u0442\u043E \u0447\u0442\u043E-\u0442\u043E \u0432\u0440\u043E\u0434\u0435
      \u0441\u0442\u0438\u043A\u0435\u0440\u0430. \u043E\u0442\u043E\u0440\u0432\u0430\u0442\u044C
      \u043D\u0435 \u0432\u0439\u0434\u0435\u0442, \u043D\u043E \u0435\u0441\u043B\u0438
      \u0435\u0433\u043E \u043F\u043E\u0442\u044F\u043D\u0443\u0442\u044C \u0432
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u043F\u043E\u0434 \u043D\u0438\u043C
      \u043C\u043E\u0436\u043D\u043E \u043E\u0442\u044B\u0441\u043A\u0430\u0442\u044C
      \u0437\u0430\u043C\u0435\u0442\u043A\u0438 \u0438\u043B\u0438 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438. 
      \u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C!"
    portrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  autoProgressLines: 010101
  autoProgressDelay: 5
