  m_Name: SixDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: "\u0410\u0432\u0438\u0441"
  npcPortrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  typingSpeed: 0.01
  voiceSoundGroupName: PencilScribe
  voicePitch: 1
  loopVoiceSound: 1
  dialogueLines:
  - text: "\u041E, \u0432 \u0442\u0430\u043A\u0438\u0435 \u043F\u043E\u0440\u0442\u0430\u043B\u044B
      \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0437\u0430\u0439\u0442\u0438! "
    portrait: {fileID: 21300000, guid: b19dd5a551c5f8e4db38bce5172497ac, type: 3}
  - text: "\u041D\u0443, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435... \u042F
      \u0442\u0430\u043C \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
      \u0431\u044B\u043B\u0430 \u2014 \u043C\u0435\u043D\u044F \u043D\u0435 \u043F\u0443\u0441\u043A\u0430\u0435\u0442,
      \u0442\u0430\u043A \u0447\u0442\u043E \u0441 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u043C\u0438
      \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430\u043C\u0438
      \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u0441\u0432\u043E\u0438\u043C\u0438 \u0441\u0438\u043B\u0430\u043C\u0438."
    portrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  autoProgressLines: 0101
  autoProgressDelay: 5
