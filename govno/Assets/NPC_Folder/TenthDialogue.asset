  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bfc6122d5880cd54ba6904cba18bf544, type: 3}
  m_Name: TenthDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: "\u0410\u0432\u0438\u0441"
  npcPortrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  typingSpeed: 0.01
  voiceSoundGroupName: PencilScribe
  voicePitch: 1
  loopVoiceSound: 1
  dialogueLines:
  - text: "\u0425\u043C\u043C\u043C... \u041D\u0435 \u0432\u0438\u0436\u0443 \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0442\u043E\u0439 \u0434\u0432\u0435\u0440\u044C\u044E \u043D\u0438\u043A\u0430\u043A\u0438\u0445
      \u043A\u043D\u043E\u043F\u043E\u043A. \u041C\u043E\u0436\u0435\u0442, \u043A\u0430\u043A
      \u0440\u0430\u0437 \u043A \u043D\u0435\u0439 \u0438 \u043D\u0443\u0436\u043D\u043E
      \u0447\u0442\u043E-\u0442\u043E \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438?.."
    portrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  - text: "\u0415\u0441\u043B\u0438 \u043D\u0430\u0439\u0434\u0435\u0448\u044C, \u0447\u0442\u043E
      \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C,
      \u043F\u043E\u0434\u043E\u0439\u0434\u0438 \u043A \u0434\u0432\u0435\u0440\u0438
      \u0438 \u043F\u043E\u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439
      \u0441 \u043D\u0435\u0439 (E)!"
    portrait: {fileID: 21300000, guid: b19dd5a551c5f8e4db38bce5172497ac, type: 3}
  - text: "\u041D\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0439\u0441\u044F,
      \u0435\u0441\u043B\u0438 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F. \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u0430\u043C \u043D\u0443\u0436\u0435\u043D
      \u043D\u0435 \u043E\u0434\u0438\u043D \u043F\u0440\u0435\u0434\u043C\u0435\u0442."
    portrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  autoProgressLines: 010101
  autoProgressDelay: 5
