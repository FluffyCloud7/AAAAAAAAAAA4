MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bfc6122d5880cd54ba6904cba18bf544, type: 3}
  m_Name: FiveDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: "\u0410\u0432\u0438\u0441"
  npcPortrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  typingSpeed: 0.01
  voiceSoundGroupName: PencilScribe
  voicePitch: 1
  loopVoiceSound: 1
  dialogueLines:
  - text: "\u041E\u0439! \u042D\u0442\u043E \u0447\u0435\u0440\u043D\u0438\u043B\u0430.
      \u0412 \u043D\u0438\u0445 \u043B\u0443\u0447\u0448\u0435 \u043D\u0435 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u044C...
      \u0414\u043E \u043C\u0435\u043D\u044F \u043E\u043D\u0438 \u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u043D\u0443\u0442,
      \u043D\u043E \u0442\u0435\u0431\u0435 \u0431\u0443\u0434\u0435\u0442 \u0431\u043E\u043B\u044C\u043D\u043E."
    portrait: {fileID: 21300000, guid: f8588001c6a1dbd4186860f1081f9b44, type: 3}
  - text: "\u0412\u0438\u0434\u0438\u0448\u044C \u0432\u043E\u043D \u0442\u0443 \u0433\u0443\u0431\u043A\u0443?
      \u0414\u0430\u0432\u0430\u0439 \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u043C
      \u043F\u0443\u0442\u044C \u0441 \u0435\u0435 \u043F\u043E\u043C\u043E\u0449\u044C\u044E.
      \u042F \u043C\u043E\u0433\u0443 \u0442\u0430\u0441\u043A\u0430\u0442\u044C
      \u0435\u0435 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043D\u0430\u0436\u0430\u0442\u0438\u044F
      \u041B\u041A\u041C \u0438 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0442\u044C
      \u0438\u043B\u0438 \u043E\u0442\u0434\u0430\u043B\u044F\u0442\u044C \u0441
      \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043A\u043E\u043B\u0435\u0441\u0438\u043A\u0430
      \u043C\u044B\u0448\u0438."
    portrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  - text: "\u0422\u043E\u043B\u044C\u043A\u043E \u0443\u0447\u0442\u0438, \u0447\u0442\u043E
      \u0433\u0443\u0431\u043A\u0430 \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0442
      \u0432\u043F\u0438\u0442\u044B\u0432\u0430\u0442\u044C \u0447\u0435\u0440\u043D\u0438\u043B\u0430
      \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E. \u0415\u0435
      \u043D\u0443\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u043C\u044B\u0442\u044C
      \u0432 \u0432\u043E\u0434\u0435, \u0435\u0441\u043B\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C
      \u0432\u043D\u043E\u0432\u044C \u0435\u0439 \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F.
      \u0418 \u043F\u043E\u0442\u043E\u0440\u043E\u043F\u0438\u0441\u044C, \u0447\u0435\u0440\u043D\u0438\u043B\u0430
      \u0440\u0430\u0441\u043F\u043E\u043B\u0437\u0443\u0442\u0441\u044F \u043E\u0431\u0440\u0430\u0442\u043D\u043E!"
    portrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  autoProgressLines: 010101
  autoProgressDelay: 5
