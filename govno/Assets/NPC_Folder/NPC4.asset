  npcName: "\u041F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0439"
  npcPortrait: {fileID: 0}
  dialogueLines:
  - "\u0442\u0443\u0442 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043C\u043D\u043E\u0433\u043E
    \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C, \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0448\u044C?"
  - "\u043A\u043E\u043D\u0435\u043D\u043E, \u0443 \u0442\u0435\u0431\u044F \u0436\u0435
    \u0443\u0433\u043E\u043B \u043E\u0431\u0437\u043E\u0440\u0430 \u043E\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439"
  - "\u043D\u043E \u0435\u0441\u0442\u044C \u0440\u0435\u0448\u0435\u043D\u0438\u0435!
    \u043D\u0430\u0436\u043C\u0438 \u043D\u0430 R!"
  - "\u0442\u044B \u0432\u043E\u0437\u044C\u043C\u0451\u0448\u044C \u043F\u043E\u0434
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u043F\u0442\u0438\u0446\u0443
    \u0438 \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u0443\u0440\u043E\u0432\u0432\u0435\u043D\u044C \u0441 \u0448\u0438\u0440\u043E\u043A\u043E\u0433\u043E
    \u0443\u0433\u043B\u0430!"
