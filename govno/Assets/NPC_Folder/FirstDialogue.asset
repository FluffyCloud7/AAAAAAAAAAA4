  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bfc6122d5880cd54ba6904cba18bf544, type: 3}
  m_Name: FirstDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: "\u0410\u0432\u0438\u0441"
  npcPortrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  typingSpeed: 0.01
  voiceSoundGroupName: PencilScribe
  voicePitch: 1
  loopVoiceSound: 1
  dialogueLines:
  - text: "\u041E, \u0442\u044B \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F!
      \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0441\u043A\u0430\u0436\u0438
      \u0447\u0442\u043E \u0437\u043D\u0430\u0435\u0448\u044C, \u043A\u0430\u043A
      \u0442\u0435\u0431\u044F \u0437\u043E\u0432\u0443\u0442?"
    portrait: {fileID: 21300000, guid: b19dd5a551c5f8e4db38bce5172497ac, type: 3}
  - text: ...
    portrait: {fileID: 21300000, guid: d6804c3cdc103704aafb685238b7599a, type: 3}
  - text: "\u0425\u0435\u0439? \u041C\u043E\u043B\u0447\u0430\u0442\u044C \u0432
      \u043E\u0442\u0432\u0435\u0442 \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441,
      \u0432\u043E\u043E\u0431\u0449\u0435-\u0442\u043E, \u043A\u0440\u0430\u0439\u043D\u0435
      \u043D\u0435\u0432\u0435\u0436\u043B\u0438\u0432\u043E. \u0418\u043B\u0438
      \u041F\u0438\u0441\u0430\u0442\u0435\u043B\u044C \u043D\u0435 \u0443\u0441\u043F\u0435\u043B
      \u043F\u0440\u043E\u043F\u0438\u0441\u0430\u0442\u044C \u0442\u0435\u0431\u0435
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C?.."
    portrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  - text: ...
    portrait: {fileID: 21300000, guid: d6804c3cdc103704aafb685238b7599a, type: 3}
  - text: "\u0410. \u0412\u0438\u0434\u0438\u043C\u043E, \u0442\u0430\u043A \u0438
      \u0435\u0441\u0442\u044C... \u0427\u0442\u043E \u0436, \u0431\u0443\u0434\u0435\u043C
      \u0442\u043E\u0433\u0434\u0430 \u0441\u0447\u0438\u0442\u0430\u0442\u044C,
      \u0447\u0442\u043E \u0442\u044B \u043D\u0435 \u0437\u043D\u0430\u0435\u0448\u044C
      \u043D\u0438\u0447\u0435\u0433\u043E. \u041D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439,
      \u044F \u0442\u0435\u0431\u0435 \u0432\u0441\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443! \u041D\u043E \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0434\u0430\u0432\u0430\u0439 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C,
      \u0447\u0442\u043E \u0442\u044B \u0445\u043E\u0442\u044F \u0431\u044B \u0445\u043E\u0434\u0438\u0442\u044C
      (WASD) \u043C\u043E\u0436\u0435\u0448\u044C. \u041F\u0440\u043E\u0439\u0434\u0438\u0441\u044C-\u043A\u0430
      \u043F\u043E \u043C\u043E\u0441\u0442\u0438\u043A\u0443, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E: \u0441\u043C\u043E\u0442\u0440\u0438
      (\u041C\u042B\u0428\u041A\u0410), \u043A\u0443\u0434\u0430 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0435\u0448\u044C."
    portrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  autoProgressLines: 0101010101
  autoProgressDelay: 5.2
