  m_Name: NinghtDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: "\u0410\u0432\u0438\u0441"
  npcPortrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  typingSpeed: 0.01
  voiceSoundGroupName: PencilScribe
  voicePitch: 1
  loopVoiceSound: 1
  dialogueLines:
  - text: "\u041E, \u0432\u043E\u043D \u0442\u0430 \u043A\u043E\u0440\u043E\u0431\u043E\u0447\u043A\u0430
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E
      \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0435\u0435 \u043F\u043E\u0434\u043D\u044F\u0442\u044C
      (E)! \u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0434\u043E\u0439\u0434\u0438
      \u043F\u043E\u0431\u043B\u0438\u0436\u0435."
    portrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  - text: "\u0410 \u043F\u043B\u0438\u0442\u044B \u0440\u044F\u0434\u043E\u043C \u043F\u043E\u0445\u043E\u0436\u0438
      \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0438... \u041A\u0430\u043A\u043E\u0435
      \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u043E\u0435 \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0435!"
    portrait: {fileID: 21300000, guid: b19dd5a551c5f8e4db38bce5172497ac, type: 3}
