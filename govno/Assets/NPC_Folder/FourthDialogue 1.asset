  m_Name: FourthDialogue 1
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: "\u0410\u0432\u0438\u0441"
  npcPortrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  typingSpeed: 0.01
  voiceSoundGroupName: PencilScribe
  voicePitch: 1
  loopVoiceSound: 1
  dialogueLines:
  - text: "\u0410, \u0442\u0430\u043A \u044D\u0442\u043E \u0431\u044B\u043B\u0430
      \u0442\u043E\u0447\u043A\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F.
      \u041F\u043E\u043B\u0435\u0437\u043D\u0430\u044F \u0448\u0442\u0443\u043A\u0430
      \u2014 \u0442\u0435\u043F\u0435\u0440\u044C \u0442\u0435\u0431\u0435 \u043D\u0435
      \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C
      \u0437\u0430\u043D\u043E\u0432\u043E, \u0435\u0441\u043B\u0438 \u0432\u0434\u0440\u0443\u0433
      \u0443\u043F\u0430\u0434\u0435\u0448\u044C. \u0410 \u0435\u0449\u0435 \u043E\u043D\u0430
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442 \u0442\u0435\u0431\u0435
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435, \u0435\u0441\u043B\u0438
      \u0442\u044B \u043F\u043E\u0440\u0430\u043D\u0438\u0448\u044C\u0441\u044F."
    portrait: {fileID: 21300000, guid: 57e5c32badb115646833964ef1f2b5bc, type: 3}
  autoProgressLines: 01
  autoProgressDelay: 5
