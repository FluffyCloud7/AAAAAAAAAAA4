  npcName: "\u041F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0439"
  npcPortrait: {fileID: 0}
  dialogueLines:
  - "\u044F \u0443\u0436\u0435 \u0442\u043E\u0440\u0447\u0443 \u0442\u0443\u0442
    \u043E\u0447\u0435\u043D\u044C \u0434\u043E\u043B\u0433\u043E!"
  - "\u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u0435\u0440\u0435\u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C
    \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B!"
  - "\u043F\u0440\u044B\u0433\u0430\u0442\u044C, \u043A \u0441\u043B\u043E\u0432\u0443,
    \u043D\u0430 \u041F\u0440\u043E\u0431\u0435\u043B"
  - "\u041C\u043E\u0436\u0435\u0448\u044C \u0442\u0430\u043A \u0436\u0435 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C
    \u0428\u0438\u0444\u0442, \u0447\u0442\u043E\u0431\u044B \u0431\u0435\u0436\u0430\u0442\u044C!"
  - "\u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0434\u0430\u043B\u0435\u043A\u043E
    \u043F\u0440\u044B\u0433\u0430\u0442\u044C. \u041D\u0443 \u0438 \u0431\u0435\u0433\u0430\u0442\u044C"
  typingSpeed: 0.05
  voiceSound: {fileID: 0}
